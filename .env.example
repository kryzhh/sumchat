# --- Required ---
# Discord Developer Portal → your app → Bot → Reset Token
DISCORD_TOKEN=
# https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Optional ---
# Register commands to one server for instant updates while testing.
# Leave empty to register globally (all servers the bot is in).
GUILD_ID=

# Model to use. "openrouter/free" picks any available free model.
# Comma-separate several to get automatic fallback, e.g.
# OPENROUTER_MODEL=google/gemini-2.5-flash,openrouter/free
OPENROUTER_MODEL=openrouter/free

# Safety caps
MAX_MESSAGES=1500        # most messages one summary will read
CHUNK_CHARS=40000        # transcript size per AI call before it is split
COOLDOWN_SECONDS=20      # per-user wait between summaries

# Render sets PORT automatically; used for the keep-alive health page.
PORT=3000
